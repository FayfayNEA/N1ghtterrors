            fullImg.src = smallImg.src;
        }

        // Cart functionality
        let openShopping = document.querySelector('.shopping');
        let closeShopping = document.querySelector('.closeShopping');
        let body = document.querySelector('body');

        openShopping.addEventListener('click', () => {
            body.classList.add('active');
        });

        closeShopping.addEventListener('click', () => {
            body.classList.remove('active');
        });

        function removeCartItem(event) {
            var buttonClicked = event.target;
            buttonClicked.parentElement.parentElement.remove();
            updateCartTotal();
        }

        function quantityChanged(event) {
            var input = event.target;
            if (isNaN(input.value) || input.value <= 0) {
                input.value = 1;
            }
            validateQuantity(input);
            updateCartTotal();
        } 

        function validateQuantity(input) {
            var cartItem = input.closest('.cartrow');
            var title = cartItem.querySelector('.shop-title').innerText.trim();
            var quantity = parseInt(input.value);

            console.log('Validating quantity for title:', title); // Debug log

            fetch(`/check-inventory?title=${encodeURIComponent(title)}`)
                .then(response => response.json())
                .then(data => {
                    console.log('Inventory response:', data); // Debug log
                    var maxQuantity = data.inStock || 0;
                    if (quantity > maxQuantity) {
                        alert(`Sorry, only ${maxQuantity} of this item is available.`);
                        input.value = maxQuantity;
                        updateCartTotal();
                    }
                })
                .catch(error => {
                    console.error('Error checking inventory:', error);
                });
        }

        function addToCartClicked(event) {
            var button = event.target;
            var shopItem = button.parentElement;
            var title = shopItem.getElementsByClassName('title')[0].innerText.trim();
            var price = shopItem.getElementsByClassName('thingPrice')[0].innerText;
            var imageSrc = shopItem.getElementsByClassName('random')[0].src;

            console.log('Adding to cart - Title:', title); // Debug log
            console.log('Adding to cart - Price:', price); // Debug log

            // Check inventory before adding to cart
            fetch(`/check-inventory?title=${encodeURIComponent(title)}`)
                .then(response => response.json())
                .then(data => {
                    console.log('Inventory check response:', data); // Debug log
                    if (data.inStock > 0) {
                        addItemToCart(title, price, imageSrc, 1);
                        updateCartTotal();
                    } else {
                        alert('Sorry, this item is sold out.');
                    }
                })
                .catch(error => {
                    console.error('Error checking inventory:', error);
                    alert('Error checking inventory. Please try again.');
                });
        }
        function addItemToCart(title, price, imageSrc, quantity) {
        var cartItems = document.getElementsByClassName('cartItems')[0];
        var cartItemNames = cartItems.getElementsByClassName('shop-title');
        
        // Check if item already exists in cart
        for (var i = 0; i < cartItemNames.length; i++) {
            if (cartItemNames[i].innerText.trim() === title) {
                // Item exists, check inventory before increasing quantity
                var existingRow = cartItemNames[i].closest('.cartrow');
                var quantityInput = existingRow.querySelector('.cartInput');
                var currentQuantity = parseInt(quantityInput.value);
                var newQuantity = currentQuantity + quantity;
                
                // Check inventory for the new total quantity
                fetch(`/check-inventory?title=${encodeURIComponent(title)}`)
                    .then(response => response.json())
                    .then(data => {
                        console.log('Inventory check response for existing item:', data);
                        if (newQuantity <= data.inStock) {
                            quantityInput.value = newQuantity;
                            updateCartTotal();
                        } else {
                            alert(`Sorry, only ${data.inStock} of "${title}" is available. You already have ${currentQuantity} in your cart.`);
                        }
                    })
                    .catch(error => {
                        console.error('Error checking inventory:', error);
                        alert('Error checking inventory. Please try again.');
                    });
                return;
            }
        }

        // Add new item to cart (this part stays the same)
        var cartRow = document.createElement('div');
        cartRow.classList.add('cartrow');
        var cartRowContents = `
            <div class="itemsInCart">
                <img class="cart-item" src="${imageSrc}" width="100" height="100">
                <span class="shop-title">${title}</span>
            </div>
            <span class="priceboi">$${price}</span>
            <div class="cart-quanity">
                <input class="cartInput" type="number" value="${quantity}" min="1">
                <button class="remove">remove</button>
            </div>
        `;
        cartRow.innerHTML = cartRowContents;
        cartItems.append(cartRow);
        
        cartRow.getElementsByClassName("remove")[0].addEventListener('click', removeCartItem);
        cartRow.getElementsByClassName('cartInput')[0].addEventListener('change', quantityChanged);
    }

        function processCheckout(event) {
            event.preventDefault();
            
            var cartRows = document.querySelectorAll('.cartItems .cartrow');
            if (cartRows.length === 0) {
                alert('Your cart is empty!');
                return;
            }

            var items = [];
            
            cartRows.forEach(cartRow => {
                var title_wa = cartRow.querySelector('.shop-title').innerText.trim();
                var priceText = cartRow.querySelector('.priceboi').innerText.replace('$', '').trim();
                var price_wa = parseFloat(priceText);
                var quantity_wa = parseInt(cartRow.querySelector('.cartInput').value);
                var imageUrl = cartRow.querySelector('.cart-item').src;
                
                items.push({
                    title_wa: title_wa,
                    price_wa: price_wa,
                    quantity_wa: quantity_wa,
                    imageUrl: imageUrl
                });
            });

            console.log('Processing checkout with items:', items);
            
            fetch('/checkout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ items: items })
            })
            .then(response => {
                if (!response.ok) {
                    return response.json().then(err => Promise.reject(err));
                }
                return response.json();
            })
            .then(data => {
                if (data.url) {
                    window.location.href = data.url;
                } else {
                    throw new Error('No checkout URL received');
                }
            })
            .catch(error => {
                console.error('Checkout Error:', error);
                alert(error.error || 'Checkout failed. Please try again.');
            });
        }

        function updateCartTotal() {
            var cartItemContainer = document.getElementsByClassName('cartItems')[0];
            var cartRows = cartItemContainer.getElementsByClassName('cartrow');
            var total = 0;

            for (var i = 0; i < cartRows.length; i++) {
                var cartRow = cartRows[i];
                var priceElement = cartRow.getElementsByClassName('priceboi')[0];
                var quantityElement = cartRow.getElementsByClassName('cartInput')[0];

                var price = parseFloat(priceElement.innerText.replace('$', ''));
                var quantity = parseInt(quantityElement.value) || 1;

                var subtotal = price * quantity;
                total += subtotal;
            }

            total = Math.round(total * 100) / 100;
            document.getElementsByClassName('totalPrice')[0].innerText = '$' + total;
        }

        if (document.readyState == 'loading') {
            document.addEventListener('DOMContentLoaded', ready);
        } else {
            ready();
        }
