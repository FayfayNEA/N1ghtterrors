        let titleTriggered = false;
        let hasTriggered = false;

        function handleScroll() {
            const scrollPosition = window.scrollY;
            const menuTriggerPoint = window.innerHeight * 2;
            const titleTriggerPoint = window.innerHeight * 0.5;
            
            
            if (scrollPosition > menuTriggerPoint && !hasTriggered) {
            const menuElement = document.getElementById('diagonalMenu');
            menuElement.classList.add('active');

            setTimeout(() => {
            menuElement.classList.add('typed');
            }, 2000);

            hasTriggered = true;

        }
            
            
            if (scrollPosition > titleTriggerPoint && !titleTriggered) {
                const titleElement = document.getElementById('titleElement');
                titleElement.classList.add('active');
                titleTriggered = true;
                
                startTypingTitle();

                setTimeout(() => {
                    titleElement.classList.add('phase-3');
                }, 3000);
            }
        }
        

        
        window.addEventListener('scroll', handleScroll);

        
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.diagonal-menu')) {
                document.getElementById('diagonalMenu').classList.remove('centered');
            }
        });

        
    (() => {
    const menu = document.getElementById("diagonalMenu");
    if (!menu) return;

    let scrolling = false;
    let scrollTimer = null;

    const setScrolling = () => {
        scrolling = true;
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
        scrolling = false;
        }, 180); 
    };

    window.addEventListener("scroll", setScrolling, { passive: true });
    window.addEventListener("touchmove", setScrolling, { passive: true });

    
    menu.addEventListener("click", (e) => {
        if (scrolling) {
        e.preventDefault();
        e.stopPropagation();
        return;
        }
        
        menu.classList.toggle("centered");
    }, true);

    
    let lastTouchMove = 0;
    window.addEventListener("touchmove", () => { lastTouchMove = Date.now(); }, { passive: true });

    menu.addEventListener("touchend", (e) => {
        if (Date.now() - lastTouchMove < 200) {
        e.preventDefault();
        e.stopPropagation();
        }
    }, { passive: false, capture: true });
    })();


        document.addEventListener("DOMContentLoaded", () => {
            const container = document.querySelector(".video-container");
            const video = document.getElementById("myVideo");
            if (!container||!video) return;

            ["loadeddata", "playing"].forEach((evt) => { 
                video.addEventListener(evt, () => container.classList.add("video-ready"));
            });

            const tryPlay = () => video.play().catch(() => {});
            tryPlay();

            const start = () => {
                tryPlay();
                window.removeEventListener("touchstart", start);
                window.removeEventListener("click", start);
                window.removeEventListener("pointerdown", start);
            };
            
            window.addEventListener("touchstart", start, { once: true, passive: true });
            window.addEventListener("click", start, { once: true });
            window.addEventListener("pointerdown", start, { once: true });
            });
        const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);

        const videoContainer = document.querySelector('.video-container');
        const video2= document.getElementById('myVideo');
        let hasPlayed = false;


        (() => {
        const titleWrap  = document.getElementById("titleElement");
        const menuWrap   = document.getElementById("diagonalMenu");

        const titleText  = document.querySelector("#titleElement .titleText");
        const menuText   = document.querySelector("#diagonalMenu .menu-text");

        
        const DARK_SELECTOR = ".shirt, .content, .contact";

        if (!titleWrap || !menuWrap || !titleText || !menuText) return;

        function overDark(targetEl) {
            const r = targetEl.getBoundingClientRect();

            
            let x = r.left + (r.width ? r.width / 2 : 1);
            let y = r.top  + (r.height ? r.height / 2 : 1);

            
            x = Math.max(0, Math.min(window.innerWidth  - 1, x));
            y = Math.max(0, Math.min(window.innerHeight - 1, y));

            
            const prev = targetEl.style.pointerEvents;
            targetEl.style.pointerEvents = "none";

            const stack = document.elementsFromPoint(x, y);

            targetEl.style.pointerEvents = prev;

            return stack.some(el => el && el.closest && el.closest(DARK_SELECTOR));
        }

        let raf = 0;
        function update() {
            raf = 0;
            titleWrap.classList.toggle("on-shirts", overDark(titleText));
            menuWrap.classList.toggle("on-shirts", overDark(menuText));
        }
        function requestUpdate() {
            if (!raf) raf = requestAnimationFrame(update);
        }

        window.addEventListener("scroll", requestUpdate, { passive: true });
        window.addEventListener("resize", requestUpdate);
        window.addEventListener("load", requestUpdate);

        
        const mo = new MutationObserver(requestUpdate);
        mo.observe(titleWrap, { attributes: true, attributeFilter: ["class", "style"] });
        mo.observe(menuWrap,  { attributes: true, attributeFilter: ["class", "style"] });

        requestUpdate();
        })();

        let titleHasTyped = false;

        function startTypingTitle() {
        if (titleHasTyped) return;
        titleHasTyped = true;

        const el = document.getElementById("titleText");
        if (!el) return;

        const full = (el.dataset.text || "N1GHTTERRORS");
        el.textContent = "";

        let i = 0;
        const speed = 200; 

        (function typeNext() {
            if (i <= full.length) {
            el.textContent = full.slice(0, i);
            i++;
            setTimeout(typeNext, speed);
            } else {
            el.classList.add("done");
            }
        })();
        }
        </script>
    </body>
</html>