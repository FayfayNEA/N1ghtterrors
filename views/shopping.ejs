        <script>
        /* --- 1. CORE SHOPPING & INVENTORY (Your Original Logic) --- */
        function ready() {
            var removeCartItemButtons = document.getElementsByClassName('remove');
            for (var i = 0; i < removeCartItemButtons.length; i++) {
                removeCartItemButtons[i].addEventListener('click', removeCartItem);
            }
            var quantityInputs = document.getElementsByClassName('cartInput');
            for (var i = 0; i < quantityInputs.length; i++) {
                quantityInputs[i].addEventListener('change', quantityChanged);
            }
            var addToCartButtons = document.getElementsByClassName('checkout');
            for (var i = 0; i < addToCartButtons.length; i++) {
                addToCartButtons[i].addEventListener('click', addToCartClicked);
            }
            var checkoutButton = document.getElementsByClassName('checkOut')[0];
            if (checkoutButton) {
                checkoutButton.addEventListener('click', processCheckout);
            }
            initOutOfStockButtons();
        }

        function removeCartItem(event) {
            event.target.parentElement.parentElement.remove();
            updateCartTotal();
            updateCartCounter();
        }

        function quantityChanged(event) {
            var input = event.target;
            if (isNaN(input.value) || input.value <= 0) { input.value = 1; }
            validateQuantity(input);
            updateCartTotal();
            updateCartCounter();
        }

        function validateQuantity(input) {
            var cartRow = input.closest('.cartrow');
            var quantity = parseInt(input.value, 10) || 1;
            var inventoryId = Number(cartRow.dataset.inventoryId);
            if (!Number.isFinite(inventoryId)) return;

            fetch(`/check-inventory?id=${encodeURIComponent(inventoryId)}`)
                .then(r => r.json())
                .then(data => {
                    var maxQuantity = Number(data.inStock || 0);
                    if (quantity > maxQuantity) {
                        alert(`Sorry, only ${maxQuantity} of this item is available.`);
                        input.value = maxQuantity;
                        updateCartTotal();
                        updateCartCounter();
                    }
                }).catch(err => console.error('Error checking inventory:', err));
        }

        function addToCartClicked(event) {
            var button = event.target;
            var shopItem = button.parentElement;
            var title = shopItem.getElementsByClassName('title')[0].innerText.trim();
            var price = shopItem.getElementsByClassName('thingPrice')[0].innerText;
            var imageSrc = shopItem.getElementsByClassName('random')[0].src;
            var sizeDropdown = shopItem.querySelector('select');
            var inventoryId = sizeDropdown ? Number(sizeDropdown.value) : Number(shopItem.dataset.inventoryId);
            var sizeLabel = sizeDropdown ? sizeDropdown.options[sizeDropdown.selectedIndex].text : '';
            var displayTitle = sizeLabel ? `${sizeLabel} - ${title}` : title;

            fetch(`/check-inventory?id=${encodeURIComponent(inventoryId)}`)
                .then(r => r.json())
                .then(data => {
                    if ((data.inStock || 0) > 0) {
                        addItemToCart(displayTitle, price, imageSrc, 1, null, inventoryId);
                        updateCartTotal();
                        updateCartCounter();
                    } else { alert('Sorry, this item is sold out.'); }
                });
        }

        function addItemToCart(title, price, imageSrc, quantity, lookupTitle = null, inventoryId = null) {
            var cartItems = document.getElementsByClassName('cartItems')[0];
            var cartItemNames = cartItems.getElementsByClassName('shop-title');
            for (var i = 0; i < cartItemNames.length; i++) {
                if (cartItemNames[i].innerText.trim() === title) {
                    var existingRow = cartItemNames[i].closest('.cartrow');
                    var qtyInput = existingRow.querySelector('.cartInput');
                    qtyInput.value = parseInt(qtyInput.value) + quantity;
                    updateCartTotal();
                    updateCartCounter();
                    return;
                }
            }
            var cartRow = document.createElement('div');
            cartRow.classList.add('cartrow');
            if (inventoryId != null) cartRow.dataset.inventoryId = inventoryId;
            cartRow.innerHTML = `
                <div class="itemsInCart"><img class="cart-item" src="${imageSrc}" width="100" height="100"><span class="shop-title">${title}</span></div>
                <span class="priceboi">$${price}</span>
                <div class="cart-quanity"><input class="cartInput" type="number" value="${quantity}" min="1"><button class="remove">remove</button></div>`;
            cartItems.append(cartRow);
            cartRow.getElementsByClassName("remove")[0].addEventListener('click', removeCartItem);
            cartRow.getElementsByClassName('cartInput')[0].addEventListener('change', quantityChanged);
            updateCartTotal();
            updateCartCounter();
        }

        function processCheckout(event) {
            event.preventDefault();
            var cartRows = document.querySelectorAll('.cartItems .cartrow');
            if (cartRows.length === 0) { alert('Your cart is empty!'); return; }
            var items = Array.from(cartRows).map(row => ({
                inventoryId: parseInt(row.dataset.inventoryId, 10),
                quantity_wa: parseInt(row.querySelector('.cartInput').value)
            }));
            fetch('/checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: items })
            }).then(r => r.json()).then(data => { if (data.url) window.location.href = data.url; });
        }

        function updateCartTotal() {
            var cartRows = document.getElementsByClassName('cartrow');
            var total = 0;
            for (var i = 0; i < cartRows.length; i++) {
                var price = parseFloat(cartRows[i].getElementsByClassName('priceboi')[0].innerText.replace('$', ''));
                var qty = parseInt(cartRows[i].getElementsByClassName('cartInput')[0].value) || 1;
                total += (price * qty);
            }
            document.getElementsByClassName('totalPrice')[0].innerText = '$' + (Math.round(total * 100) / 100);
        }

        function updateCartCounter() {
            var count = 0;
            document.querySelectorAll('.cartItems .cartInput').forEach(input => { count += parseInt(input.value) || 0; });
            document.getElementById('cartCounter').textContent = count;
        }

        function initOutOfStockButtons() {
            const productTextBlocks = document.querySelectorAll(".content .texts");
            productTextBlocks.forEach(block => {
                const addBtn = block.querySelector("button.checkout");
                const soldOutEl = block.querySelector(".soldout");
                const sizeSelect = block.querySelector("select");
                if (!addBtn || !soldOutEl) return;
                async function checkStock() {
                    const id = sizeSelect ? Number(sizeSelect.value) : Number(block.dataset.inventoryId);
                    const res = await fetch(`/check-inventory?id=${encodeURIComponent(id)}`);
                    const data = await res.json();
                    const inStock = Number(data.inStock || 0);
                    addBtn.disabled = inStock <= 0;
                    soldOutEl.hidden = inStock > 0;
                    recalcOpenContent(block.closest(".content"));
                }
                checkStock();
                if (sizeSelect) sizeSelect.addEventListener("change", checkStock);
            });
        }

        
        const adjustContentHeight = (content) => {
            if (content.style.maxHeight && content.style.maxHeight !== "0px") {
                content.style.maxHeight = "0px";
                content.classList.remove("active");
            } else {
                content.style.maxHeight = (content.scrollHeight + 100) + "px";
                content.classList.add("active");
            }
        };

        
        window.addEventListener('load', function() {
            const shirts = document.getElementsByClassName("shirt");
            
            
            for (let i = 0; i < shirts.length; i++) {
                const button = shirts[i];
                const content = button.nextElementSibling;

                
                button.classList.add("active");
                content.classList.add("active");

                
                setTimeout(() => {
                    const fullHeight = content.scrollHeight;
                    content.style.maxHeight = (fullHeight + 120) + "px";
                    console.log(`Deployed shirt ${i} at height: ${fullHeight}`);
                }, 200);

                
                button.onclick = function() {
                    if (content.style.maxHeight !== "0px") {
                        content.style.maxHeight = "0px";
                        this.classList.remove("active");
                        content.classList.remove("active");
                    } else {
                        content.style.maxHeight = (content.scrollHeight + 120) + "px";
                        this.classList.add("active");
                        content.classList.add("active");
                    }
                };
            }
            
            // Initialize your shopping functions
            ready(); 
        });

        function recalcOpenContent(content, extra = 60) {
            if (!content || content.style.maxHeight === "0px") return;
            content.style.maxHeight = (content.scrollHeight + extra) + "px";
        }

        /* --- 3. GALLERY & UI TRIGGERS --- */
        function myFunction(smallImg) { document.getElementById("imageBox").src = smallImg.src; }
        function myFunction1(smallImg) { document.getElementById("imageBox1").src = smallImg.src; }
        function myFunction2(smallImg) { document.getElementById("imageBox2").src = smallImg.src; }
        function myFunction3(smallImg) { document.getElementById("imageBox3").src = smallImg.src; }
        function myFunction4(smallImg) { document.getElementById("imageBox4").src = smallImg.src; }
        function myFunction5(smallImg) { document.getElementById("imageBox5").src = smallImg.src; }

        let openShopping = document.querySelector('.shopping');
        let closeShopping = document.querySelector('.closeShopping');
        openShopping.addEventListener('click', () => { document.body.classList.add('active'); });
        closeShopping.addEventListener('click', () => { document.body.classList.remove('active'); });

        /* --- 4. VIDEO LOGIC --- */
        document.addEventListener("DOMContentLoaded", () => {
            const container = document.querySelector(".video-container");
            const video = document.getElementById("myVideo");
            if (!container || !video) return;
            ["loadeddata", "playing"].forEach((evt) => {
                video.addEventListener(evt, () => container.classList.add("video-ready"));
            });
            const tryPlay = () => video.play().catch(() => {});
            tryPlay();
            // Special fix for iPhone low power mode
            window.addEventListener("click", tryPlay, { once: true });
        });

        /* --- 5. PERFORMANCE & SCROLL (Lag Fix) --- */
        let titleTriggered = false, hasTriggered = false;
        const scrollObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    if (entry.target.id === 'diagonalMenu' && !hasTriggered) {
                        entry.target.classList.add('active');
                        setTimeout(() => { entry.target.classList.add('typed'); }, 2000);
                        hasTriggered = true;
                    }
                    if (entry.target.id === 'titleElement' && !titleTriggered) {
                        entry.target.classList.add('active');
                        startTypingTitle();
                        setTimeout(() => { entry.target.classList.add('phase-3'); }, 3000);
                        titleTriggered = true;
                    }
                }
            });
        }, { threshold: 0.1 });

        document.addEventListener('DOMContentLoaded', () => {
            const menu = document.getElementById('diagonalMenu'), title = document.getElementById('titleElement');
            if (menu) scrollObserver.observe(menu);
            if (title) scrollObserver.observe(title);
        });

        // Menu Scroll-Safety Hack
        (() => {
            const menu = document.getElementById("diagonalMenu");
            if (!menu) return;
            let scrolling = false, scrollTimer = null;
            window.addEventListener("scroll", () => {
                scrolling = true;
                clearTimeout(scrollTimer);
                scrollTimer = setTimeout(() => { scrolling = false; }, 180);
            }, { passive: true });
            menu.addEventListener("click", (e) => { if (!scrolling) menu.classList.toggle("centered"); }, true);
        })();

        /* --- 6. COLOR DETECTION (Over-Dark Logic) --- */
        (() => {
            const titleWrap = document.getElementById("titleElement"), menuWrap = document.getElementById("diagonalMenu");
            const titleText = document.querySelector("#titleElement .titleText"), menuText = document.querySelector("#diagonalMenu .menu-text");
            const DARK_SELECTOR = ".shirt, .content, .contact";
            if (!titleWrap || !menuWrap || !titleText || !menuText) return;

            function overDark(targetEl) {
                const r = targetEl.getBoundingClientRect();
                let x = Math.max(0, Math.min(window.innerWidth - 1, r.left + r.width / 2));
                let y = Math.max(0, Math.min(window.innerHeight - 1, r.top + r.height / 2));
                const prev = targetEl.style.pointerEvents;
                targetEl.style.pointerEvents = "none";
                const stack = document.elementsFromPoint(x, y);
                targetEl.style.pointerEvents = prev;
                return stack.some(el => el && el.closest && el.closest(DARK_SELECTOR));
            }

            let raf = 0;
            function update() {
                raf = 0;
                titleWrap.classList.toggle("on-shirts", overDark(titleText));
                menuWrap.classList.toggle("on-shirts", overDark(menuText));
            }
            window.addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
            const mo = new MutationObserver(() => { if (!raf) raf = requestAnimationFrame(update); });
            mo.observe(titleWrap, { attributes: true, attributeFilter: ["class"] });
            mo.observe(menuWrap, { attributes: true, attributeFilter: ["class"] });
        })();

        let titleHasTyped = false;
        function startTypingTitle() {
            if (titleHasTyped) return; titleHasTyped = true;
            const el = document.getElementById("titleText");
            const full = (el.dataset.text || "N1GHTTERRORS");
            let i = 0;
            (function typeNext() {
                if (i <= full.length) {
                    el.textContent = full.slice(0, i++);
                    setTimeout(typeNext, 200);
                } else { el.classList.add("done"); }
            })();
        }
        </script>

    </body>
</html>